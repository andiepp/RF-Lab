<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The Studio key styles, shared by Studio dark and Studio light:
         the same style keys as Classic.xaml, drawn as rounded keys and lit
         toggles. Colours from StudioDark.xaml or StudioLight.xaml. -->

    <Style x:Key="RfKeyStyle" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource RfText}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Overlay" Background="{DynamicResource StudioSurface}" BorderBrush="{DynamicResource StudioLine}"
                            BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="BorderBrush" Value="{DynamicResource StudioLineHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource StudioPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RfToggleKeyStyle" TargetType="ToggleButton" BasedOn="{StaticResource RfKeyStyle}" />

    <!-- start/stop: a key whose border says what a click does -->
    <Style x:Key="RfStartStopStyle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource RfText}" />
        <Setter Property="Content" Value="Start" />
        <Setter Property="BorderBrush" Value="{DynamicResource RfStart}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Overlay" Background="{DynamicResource StudioSurface}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="2" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource RfStop}" />
                            <Setter Property="Foreground" Value="{DynamicResource StudioOnAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Content" Value="Stop" />
                <Setter Property="BorderBrush" Value="{DynamicResource RfStop}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RfRunHaltStyle" TargetType="ToggleButton" BasedOn="{StaticResource RfStartStopStyle}">
        <Setter Property="Content" Value="Run" />
        <Setter Property="FontWeight" Value="Normal" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Content" Value="Halt" />
                <Setter Property="BorderBrush" Value="{DynamicResource RfStop}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- the digit arrows: quiet strips that light up under the mouse -->
    <Style x:Key="RfDigitArrowStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Strip" Background="{DynamicResource StudioArrow}" CornerRadius="2" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Strip" Property="Background" Value="{DynamicResource StudioAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RfTraceToggleStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource RfText}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" VerticalAlignment="Center"
                                Background="{DynamicResource StudioSurface}" BorderBrush="{DynamicResource StudioLineHover}" BorderThickness="1">
                            <Path x:Name="Tick" Data="M 3.5,8 L 6.5,11 L 12.5,4.5" Stroke="{DynamicResource StudioOnAccent}"
                                  StrokeThickness="2" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource StudioAccent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource StudioAccent}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StudioComboToggleStyle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Frame" Background="{DynamicResource StudioSurface}" BorderBrush="{DynamicResource StudioLine}"
                            BorderThickness="1" CornerRadius="6">
                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                              Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource RfDimText}" StrokeThickness="1.5" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource StudioLineHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource StudioAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RfComboStyle" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource RfText}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource StudioComboToggleStyle}"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                        <ContentPresenter Margin="8,0,22,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade">
                            <Border Margin="0,2,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource RfListBackground}" BorderBrush="{DynamicResource StudioLine}"
                                    BorderThickness="1" CornerRadius="6" Padding="2">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="{DynamicResource RfText}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="8,4">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource StudioPressed}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource StudioAccent}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="BorderBrush" Value="{DynamicResource StudioLine}" />
    </Style>
</ResourceDictionary>
