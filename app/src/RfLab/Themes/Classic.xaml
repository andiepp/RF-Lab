<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Classic: the original RF-Lab application's colours. Every theme
         defines the same keys; Styles.xaml uses them. -->

    <SolidColorBrush x:Key="MainWindowBackground" Color="Black" />
    <SolidColorBrush x:Key="StatusBarTextBrush" Color="White" />
    <SolidColorBrush x:Key="TabTextBrush" Color="White" />
    <SolidColorBrush x:Key="AccentBrush" Color="White" />

    <SolidColorBrush x:Key="RfTopBarBackground" Color="Black" />
    <SolidColorBrush x:Key="RfTopBarLine" Color="DarkGray" />
    <SolidColorBrush x:Key="RfText" Color="White" />
    <SolidColorBrush x:Key="RfDimText" Color="#FFB0B0B0" />
    <SolidColorBrush x:Key="RfHeaderBackground" Color="Black" />
    <SolidColorBrush x:Key="RfHeaderText" Color="White" />
    <SolidColorBrush x:Key="RfHeaderLine" Color="DarkGray" />
    <SolidColorBrush x:Key="RfSeparator" Color="#FF2B2929" />
    <SolidColorBrush x:Key="RfDisplayBackground" Color="Black" />

    <SolidColorBrush x:Key="RfFrequencyBackground" Color="Maroon" />
    <SolidColorBrush x:Key="RfAmplitudeBackground" Color="DarkBlue" />
    <SolidColorBrush x:Key="RfDialText" Color="White" />
    <SolidColorBrush x:Key="RfDialLine" Color="LightGray" />
    <SolidColorBrush x:Key="RfRangeBackground" Color="Black" />
    <SolidColorBrush x:Key="RfRangeText" Color="White" />

    <SolidColorBrush x:Key="RfModulationBackground" Color="LightYellow" />
    <SolidColorBrush x:Key="RfClockBackground" Color="AliceBlue" />
    <SolidColorBrush x:Key="RfPanelText" Color="Blue" />
    <SolidColorBrush x:Key="RfDigitBackground" Color="White" />
    <SolidColorBrush x:Key="RfDigitText" Color="Black" />
    <SolidColorBrush x:Key="RfDigitLine" Color="LightGray" />

    <SolidColorBrush x:Key="RfChartSeries" Color="LightGreen" />
    <SolidColorBrush x:Key="RfChartAxis" Color="#FF808080" />
    <SolidColorBrush x:Key="RfChartLabel" Color="White" />
    <SolidColorBrush x:Key="RfReadout" Color="LightGreen" />

    <SolidColorBrush x:Key="RfListBackground" Color="Black" />
    <SolidColorBrush x:Key="RfListText" Color="White" />
    <SolidColorBrush x:Key="RfTraceBackground" Color="Black" />
    <SolidColorBrush x:Key="RfTraceSent" Color="#FFFFD27F" />
    <SolidColorBrush x:Key="RfTraceText" Color="LightGreen" />

    <SolidColorBrush x:Key="RfStart" Color="LightGreen" />
    <SolidColorBrush x:Key="RfStop" Color="Salmon" />
    <SolidColorBrush x:Key="RfError" Color="Firebrick" />
    <SolidColorBrush x:Key="RfLedOn" Color="LightGreen" />
    <SolidColorBrush x:Key="RfLedOff" Color="Red" />
    <SolidColorBrush x:Key="RfConnected" Color="LightGreen" />

    <FontFamily x:Key="RfDigitFont">Calibri</FontFamily>
    <FontFamily x:Key="RfMonoFont">Consolas</FontFamily>
    <CornerRadius x:Key="RfCardRadius">0</CornerRadius>
    <sys:Double x:Key="RfHeaderFontSize">16</sys:Double>

    <!-- the system's own buttons and lists, as the original had them -->
    <Style x:Key="RfKeyStyle" TargetType="ButtonBase" />
    <Style x:Key="RfToggleKeyStyle" TargetType="ToggleButton" />
    <Style x:Key="RfDigitArrowStyle" TargetType="Button" />
    <Style x:Key="RfComboStyle" TargetType="ComboBox" />

    <Style x:Key="RfStartStopStyle" TargetType="ToggleButton">
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="Content" Value="Start" />
        <Setter Property="BorderBrush" Value="{DynamicResource RfStart}" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Content" Value="Stop" />
                <Setter Property="BorderBrush" Value="{DynamicResource RfStop}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RfRunHaltStyle" TargetType="ToggleButton">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Content" Value="Run" />
        <Setter Property="BorderBrush" Value="{DynamicResource RfStart}" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Content" Value="Halt" />
                <Setter Property="BorderBrush" Value="{DynamicResource RfStop}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RfTraceToggleStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource RfText}" />
    </Style>
</ResourceDictionary>
