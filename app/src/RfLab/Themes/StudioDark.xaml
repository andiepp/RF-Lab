<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Studio dark: slate surfaces, one teal accent, the frequency and
         amplitude displays keep a hint of the original red and blue. The
         same keys as Classic.xaml; the key styles are in StudioStyles.xaml. -->

    <SolidColorBrush x:Key="MainWindowBackground" Color="#FF11151B" />
    <SolidColorBrush x:Key="StatusBarTextBrush" Color="#FF8B97A8" />
    <SolidColorBrush x:Key="TabTextBrush" Color="#FFE7EBF1" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF2FC4B2" />

    <SolidColorBrush x:Key="RfTopBarBackground" Color="#FF161B22" />
    <SolidColorBrush x:Key="RfTopBarLine" Color="#FF2B3440" />
    <SolidColorBrush x:Key="RfText" Color="#FFE7EBF1" />
    <SolidColorBrush x:Key="RfDimText" Color="#FF8B97A8" />
    <SolidColorBrush x:Key="RfHeaderBackground" Color="#FF161B22" />
    <SolidColorBrush x:Key="RfHeaderText" Color="#FFE7EBF1" />
    <SolidColorBrush x:Key="RfHeaderLine" Color="#FF2B3440" />
    <SolidColorBrush x:Key="RfSeparator" Color="#FF0B0E12" />
    <SolidColorBrush x:Key="RfDisplayBackground" Color="#FF141920" />

    <SolidColorBrush x:Key="RfFrequencyBackground" Color="#FF3A1C22" />
    <SolidColorBrush x:Key="RfAmplitudeBackground" Color="#FF18243F" />
    <SolidColorBrush x:Key="RfDialText" Color="#FFF2F5F9" />
    <SolidColorBrush x:Key="RfDialLine" Color="#FF2B3440" />
    <SolidColorBrush x:Key="RfRangeBackground" Color="#FF141920" />
    <SolidColorBrush x:Key="RfRangeText" Color="#FF6F7B8C" />

    <SolidColorBrush x:Key="RfModulationBackground" Color="#FF1A2028" />
    <SolidColorBrush x:Key="RfClockBackground" Color="#FF1A2028" />
    <SolidColorBrush x:Key="RfPanelText" Color="#FF8B97A8" />
    <SolidColorBrush x:Key="RfDigitBackground" Color="#FF212833" />
    <SolidColorBrush x:Key="RfDigitText" Color="#FFE7EBF1" />
    <SolidColorBrush x:Key="RfDigitLine" Color="#FF2B3440" />

    <SolidColorBrush x:Key="RfChartSeries" Color="#FF2FC4B2" />
    <SolidColorBrush x:Key="RfChartAxis" Color="#FF4A5566" />
    <SolidColorBrush x:Key="RfChartLabel" Color="#FF8B97A8" />
    <SolidColorBrush x:Key="RfReadout" Color="#FF2FC4B2" />

    <SolidColorBrush x:Key="RfListBackground" Color="#FF161B22" />
    <SolidColorBrush x:Key="RfListText" Color="#FFE7EBF1" />
    <SolidColorBrush x:Key="RfTraceBackground" Color="#FF0E1116" />
    <SolidColorBrush x:Key="RfTraceSent" Color="#FFF0B54A" />
    <SolidColorBrush x:Key="RfTraceText" Color="#FF9FE6C9" />

    <SolidColorBrush x:Key="RfStart" Color="#FF2FC4B2" />
    <SolidColorBrush x:Key="RfStop" Color="#FFFF6B6B" />
    <SolidColorBrush x:Key="RfError" Color="#FFFF6B6B" />
    <SolidColorBrush x:Key="RfLedOn" Color="#FF2FC4B2" />
    <SolidColorBrush x:Key="RfLedOff" Color="#FF4A5566" />
    <SolidColorBrush x:Key="RfConnected" Color="#FF2FC4B2" />

    <FontFamily x:Key="RfDigitFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="RfMonoFont">Cascadia Mono, Consolas</FontFamily>
    <CornerRadius x:Key="RfCardRadius">8</CornerRadius>
    <sys:Double x:Key="RfHeaderFontSize">15</sys:Double>

    <!-- Studio only: the surfaces and the accent the key styles use -->
    <SolidColorBrush x:Key="StudioSurface" Color="#FF212833" />
    <SolidColorBrush x:Key="StudioLine" Color="#FF2B3440" />
    <SolidColorBrush x:Key="StudioLineHover" Color="#FF3E4A5B" />
    <SolidColorBrush x:Key="StudioPressed" Color="#FF2B3440" />
    <SolidColorBrush x:Key="StudioAccent" Color="#FF2FC4B2" />
    <SolidColorBrush x:Key="StudioOnAccent" Color="#FF0E1116" />
    <SolidColorBrush x:Key="StudioArrow" Color="#552FC4B2" />
</ResourceDictionary>
