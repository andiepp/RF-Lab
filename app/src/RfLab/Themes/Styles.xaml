<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Styles every theme shares. They take their colours from the theme
         dictionary loaded before this one, hence DynamicResource throughout.
         Styles that differ by theme (keys, toggles, lists) live in the theme
         files themselves. -->

    <Style x:Key="HeaderLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource RfHeaderFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Background" Value="{DynamicResource RfHeaderBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource RfHeaderText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RfHeaderLine}" />
        <Setter Property="BorderThickness" Value="0,1" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <Style x:Key="ModLabel" TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource RfPanelText}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="1,0,3,0" />
    </Style>

    <Style x:Key="ModRB" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource RfPanelText}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="6,0,2,0" />
    </Style>

    <Style x:Key="RangeLabel" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource RfRangeText}" />
        <Setter Property="Background" Value="{DynamicResource RfRangeBackground}" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="InfoText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource RfDimText}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="8,2,4,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="TopBarText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource RfDimText}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="10,0,6,0" />
    </Style>

    <Style x:Key="TabControlStyle" TargetType="TabControl">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderBrush" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{DynamicResource RfDisplayBackground}" />
    </Style>

    <!-- the original's tab: an accent bar left of the selected header -->
    <Style x:Key="TabItemStyle" TargetType="TabItem">
        <Setter Property="BorderBrush" Value="{x:Null}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TabTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border Name="Border" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}"
                            Background="{DynamicResource MainWindowBackground}" Margin="10,5,5,5">
                        <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          ContentSource="Header" Margin="2" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="False">
                            <Setter TargetName="Border" Property="BorderThickness" Value="0" />
                            <Setter Property="FontWeight" Value="Normal" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Border" Property="BorderThickness" Value="3,0,0,1" />
                            <Setter TargetName="Border" Property="Padding" Value="5,0,0,0" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PresetListItemStyle" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="2,1" />
        <Setter Property="Padding" Value="3,2" />
        <Setter Property="Foreground" Value="{DynamicResource RfListText}" />
    </Style>
</ResourceDictionary>
