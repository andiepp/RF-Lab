<UserControl x:Class="RfLab.Controls.NCMultiDigit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RfLab.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="72" d:DesignWidth="72">
    
    <Border BorderBrush="{DynamicResource RfDigitLine}" BorderThickness="1" CornerRadius="1" Height="70">
        <StackPanel 
            Name="DigitsPanel" 
            Width="Auto" Height="Auto" 
            Orientation="Horizontal" 
            Background="{Binding NC_Background}"
            HorizontalAlignment="Stretch" 
            VerticalAlignment="Stretch"/>
    </Border>
    
</UserControl>
