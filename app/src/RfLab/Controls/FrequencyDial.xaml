<UserControl x:Class="RfLab.Controls.FrequencyDial"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RfLab.Controls"
             FontFamily="Courier New"
             mc:Ignorable="d" 
             d:DesignHeight="128" d:DesignWidth="330"
             Height="128" Width="330">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="72"/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>


        <Label
            Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
            Style="{StaticResource RangeLabel}"
            Content="Frequency" 
            Foreground="{DynamicResource RfDialText}"
            FontFamily="Arial" FontSize="18" FontWeight="Bold"
            Background="{DynamicResource RfFrequencyBackground}"
            />

        <Canvas Grid.Column="3" Grid.Row="0" Background="{DynamicResource RfFrequencyBackground}"/>

        <TextBox
            x:Name="TB_Frequency"
            Grid.Column="3" Grid.Row="0" Margin="8,2" Padding="2,0"
            Height="24" FontSize="14"
            Foreground="{DynamicResource RfDialText}"
            CaretBrush="{DynamicResource RfDialText}"
            BorderBrush="{DynamicResource RfDialLine}"
            Background="Transparent"
            VerticalContentAlignment="Center"
            HorizontalContentAlignment="Right"
            KeyDown="TB_Frequency_KeyDown"                 
            />

        <Viewbox 
            x:Name="VB_FrequencyDial"
            Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" 
            Width="330" 
            HorizontalAlignment="Left" >
            <local:NCMultiDigit 
                x:Name="NCMD_Frequency" 
                FormatString="000 000 000"
                Min="100000" Max="300000000" Value="10000000" 
                NC_Background="{StaticResource RfFrequencyBackground}"
                NC_Foreground="{StaticResource RfDialText}"
                SpaceWidth="4" SpaceHeight="4" >
            </local:NCMultiDigit>
        </Viewbox>
        
        <Label
            Grid.Column="0" Grid.Row="2"
            Style="{StaticResource RangeLabel}"
            Content="---- MHz ----"
            />

        <Label
            Grid.Column="1" Grid.Row="2"
            Style="{StaticResource RangeLabel}"
            Content="---- KHz ----"
            />

        <Label
            Grid.Column="2" Grid.Row="2"
            Style="{StaticResource RangeLabel}"
            Content="---- Hz ----"
            />
        
    </Grid>
    
</UserControl>
